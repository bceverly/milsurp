#!/usr/bin/env bash
#
# Milsurp Monitor — pre-commit hook.
#
# Blocks the commit if there are ANY lint findings, and specifically if black
# reports it would reformat files. Installed by `make install-hooks`.
#
# Bypass (use sparingly, and never on a shared branch):
#     git commit --no-verify
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd)"
# When installed into .git/hooks the path above resolves to the repo root
# already; when run from .githooks/ it does not. Resolve by looking for the
# Makefile rather than assuming a depth.
while [ -n "$REPO_ROOT" ] && [ ! -f "$REPO_ROOT/Makefile" ] && [ "$REPO_ROOT" != "/" ]; do
  REPO_ROOT="$(dirname "$REPO_ROOT")"
done
cd "$REPO_ROOT" || exit 1

printf '\n\033[1;94m▸ pre-commit: linting\033[0m\n'

if [ ! -x scripts/lint.sh ]; then
  printf '\033[93m  scripts/lint.sh is missing — skipping (run: make install-hooks)\033[0m\n'
  exit 0
fi

# scripts/lint.sh runs black --check first and exits non-zero if anything is
# unformatted, so "black changed files" and "a linter complained" are both
# covered by this single exit code.
if scripts/lint.sh; then
  printf '\033[1;92m✓ pre-commit passed.\033[0m\n\n'
  exit 0
fi

cat <<'BLOCKED'

  ────────────────────────────────────────────────────────────────
   COMMIT BLOCKED — lint reported findings.

   Fix them, or let the formatters do it:

       make lint-fix        reformat and auto-fix
       git add -u           re-stage what changed
       git commit           try again

   Then re-run `make lint` to confirm it is clean.

   To bypass in an emergency:  git commit --no-verify
  ────────────────────────────────────────────────────────────────

BLOCKED
exit 1
