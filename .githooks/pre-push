#!/usr/bin/env bash
#
# Milsurp Monitor — pre-push hook.
#
# The last gate before code leaves the machine: lint must be clean.
#
# Deliberately does NOT run the test suites. They take minutes, they would run
# again for every tag push, and CI runs them on every push anyway — a hook slow
# enough to be routinely bypassed protects nothing.
#
# Bypass:  git push --no-verify
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd)"
while [ -n "$REPO_ROOT" ] && [ ! -f "$REPO_ROOT/Makefile" ] && [ "$REPO_ROOT" != "/" ]; do
  REPO_ROOT="$(dirname "$REPO_ROOT")"
done
cd "$REPO_ROOT" || exit 1

FAILED=()

printf '\n\033[1;94m▸ pre-push: lint\033[0m\n'
if [ -x scripts/lint.sh ]; then
  if scripts/lint.sh >/dev/null 2>&1; then
    printf '\033[92m  ✓ clean\033[0m\n'
  else
    printf '\033[91m  ✗ findings\033[0m\n'
    FAILED+=("lint")
  fi
else
  printf '\033[93m  - scripts/lint.sh missing, skipped\033[0m\n'
fi

printf '\n'
if [ ${#FAILED[@]} -eq 0 ]; then
  printf '\033[1;92m✓ pre-push passed.\033[0m\n\n'
  exit 0
fi

cat <<BLOCKED
  ────────────────────────────────────────────────────────────────
   PUSH BLOCKED — failed: ${FAILED[*]}

   Reproduce with:

       make lint          (make lint-fix reformats)

   The test suites are not run here: they are slow, and CI runs them
   on every push. Run them locally with \`make test\` when you want them.

   To bypass in an emergency:  git push --no-verify
  ────────────────────────────────────────────────────────────────

BLOCKED
exit 1
