.pnp.*

# --- Application data (runtime state, never in version control) ---
#
# Unanchored on purpose -- runtime state turns up in more than one place -- but
# note that it therefore matches a `data/` directory at ANY depth. Shipped data
# that belongs in the repository goes somewhere else for that reason: the
# armory's seed file lives in backend/app/seed/, having spent a while in
# backend/app/data/ being silently ignored.
data/
!data/.gitkeep

# The dev-mode SQLite database lives in the repo root (production keeps it in
# /etc/milsurp, or wherever database.path in config.yaml points).
/milsurp.db
/milsurp.db-journal
/milsurp.db-wal
/milsurp.db-shm

# ...and any other SQLite file anywhere in the tree.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Downloaded firearm photos (the secure image store). In dev this lives under
# data/, which is ignored above; production keeps it in /etc/milsurp.
#
# ANCHORED to the repository root on purpose: a bare "images/" would also match
# marketing/images/, which holds the committed logo, favicon, coverage badges
# and README screenshots.
/images/
media/
# Belt and braces, in case the pattern above is ever loosened again.
!marketing/images/
!marketing/images/**

# --- Runtime / process management ---
*.log
logs/
.server.pid
*.pid
.milsurp-dev-port

# --- Scraper artifacts ---
.wdm/
chromedriver
chromedriver.exe
geckodriver
geckodriver.log
selenium-debug.log

# --- TLS material (production certs live outside the repo) ---
*.pem
*.key
*.crt
*.csr
certs/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Database snapshots (see app/services/backup.py) ---
backups/
vendor/

# --- Debian packaging ---------------------------------------------------
#
# debian/ itself IS committed -- it is the packaging source, and Launchpad
# builds from it. Only the generated parts are ignored:
#
#   changelog          written by scripts/build-deb.sh from the project
#                      version, so the version lives in one place rather than
#                      three
#   milsurp.service    copied from deploy/systemd/ at build time, so the unit
#                      has a single definition
#   everything else    debhelper's own leavings and the staging tree
debian/changelog
debian/milsurp.service
debian/milsurp/
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
