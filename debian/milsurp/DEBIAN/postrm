#!/bin/sh
# Milsurp Monitor — post-removal.
#
# `remove` leaves everything that is data. `purge` removes what the package
# created and still does not touch the database or the photos: those are the
# administrator's, they can be very large, and a package that deletes a year of
# price history because someone typed `apt purge` is a package that cannot be
# trusted. It says where they are instead.
set -e

CONFIG_DIR=/etc/milsurp

case "$1" in
  purge)
    rm -rf /opt/milsurp/.venv
    rm -f "$CONFIG_DIR/config.yaml"
    # rmdir, not rm -rf: it succeeds only if nothing else is in there, which
    # is exactly the intent -- an empty config directory goes, one holding a
    # database or an image store stays.
    rmdir "$CONFIG_DIR/images" 2>/dev/null || true
    rmdir "$CONFIG_DIR" 2>/dev/null || true
    rmdir /var/log/milsurp 2>/dev/null || true
    if [ -d "$CONFIG_DIR" ]; then
      echo "Milsurp: left $CONFIG_DIR in place — it still holds the database"
      echo "  and/or the downloaded photos. Remove it by hand if you mean to."
    fi
    ;;
  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	systemctl --system daemon-reload >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "purge" ]; then
	if [ -x "/usr/bin/deb-systemd-helper" ]; then
		deb-systemd-helper purge 'milsurp.service' >/dev/null || true
	fi
fi
# End automatically added section


exit 0
