# Milsurp Monitor — off-machine backups.
#
#   sudo install -m 0644 milsurp-offsite /etc/cron.d/milsurp-offsite
#
# /etc/cron.d needs the user field (root) and a PATH of its own: cron's default
# does not include /usr/local/sbin, and neither script is anywhere else.
#
# Set NAS_TARGET here rather than editing the scripts, so an upgrade that
# replaces them does not take your configuration with it.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

NAS_TARGET=backup@nas.lan
SSH_KEY=/root/.ssh/id_milsurp_backup

# The database and the config, nightly at 03:10.
#
# Before the image prune at 04:20 and the canary at 06:10, and clear of the
# application's own backup window: three jobs arriving together on one disk is
# how a backup comes to time out.
10 3 * * *  root  NAS_PATH=/volume1/backups/milsurp milsurp-offsite >> /var/log/milsurp-offsite.log 2>&1

# The photo store, Sundays at 02:30.
#
# Weekly because it is re-downloadable — `milsurp fetch-photos` rebuilds it
# from URLs the database already holds — so this saves a week of re-fetching
# rather than saving the data itself. rsync sends only what changed after the
# first pass.
30 2 * * 0  root  NAS_PATH=/volume1/backups/milsurp-images milsurp-offsite-images >> /var/log/milsurp-offsite.log 2>&1
