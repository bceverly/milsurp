# Pinned versions of the security tools that are not installed from a package
# index. A scanner is a supply-chain dependency too, so it is pinned rather
# than tracked at "latest".
#
# Sourced by scripts/install-dev.sh and by .github/workflows/security.yml, so
# a local `make security` and the CI security job run the same binary.
GITLEAKS_VERSION=8.24.3
